APP_NAME=Softphoria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# No client-specific locale/timezone is mandated in the approved specs
# (Core Specification only requires i18n-readiness for later; "even if only
# one language is initially deployed"). These are Laravel's standard defaults.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB — Laravel (running inside the app container) connects via the
# Docker-internal service name "mariadb" on its container port 3306.
# Host PHP 8.2 / XAMPP is never used to run this application.
# host localhost:3307 is only for external tools (e.g. MySQL Workbench on Windows).
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=softphoria
DB_USERNAME=softphoria
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis — internal Docker network only ("redis:6379"). Never 127.0.0.1 from
# inside the app container, and never published to the Windows host.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Unified site-wide search (App\Modules\Search) — Laravel Scout's "database"
# driver: live LIKE queries against the existing content tables, no separate
# search index/service to run. See SearchService's own docblock for why the
# "database" driver, not Meilisearch, is correct for Phase 1.
SCOUT_DRIVER=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=livewire-tmp

# Temporary presentation-mode switch — hides the Video field/column on Track
# and Podcast Episode admin screens (UI-only; see config/admin_ui.php).
ADMIN_SHOW_VIDEO_FIELDS=true

# Temporary presentation-mode switch — hides the "Commerce" sidebar menu
# (Orders, Entitlements, Subscriptions, Download History) from the admin
# panel (UI-only; see config/admin_ui.php).
ADMIN_SHOW_COMMERCE_MENU=false

# Phase 1: no paid monthly membership. Hides subscription/Pro Membership
# promotional UI everywhere (registration, account area, admin) without
# touching the underlying Stripe/subscription code or data — see
# config/features.php.
MEMBER_SUBSCRIPTION_ENABLED=false

# Maximum seconds of a track's uploaded audio a guest (non-registered
# visitor) may hear, enforced server-side — see config/features.php.
GUEST_USER_LISTENING_LIMIT_SECONDS=30

# Maximum completed (fully played) track listens an authenticated user may
# have per calendar day, enforced server-side — see config/features.php.
REGISTERED_USER_WHOLE_SONG_LISTENS_PER_DAY=5

# Maximum character length of a "Leave a Little Light" post — see
# config/features.php for why 500 is the current default.
LIGHT_POST_MAX_LENGTH=500

# Whether a newly submitted review/rating (Podcast, Music, and later
# Inspirational Resources — see config/reviews.php) requires admin approval
# before it's shown publicly. When false, a new review is published
# immediately on submission.
REVIEWS_RATINGS_ADMIN_APPROVAL=true

# Maximum character length of a review's written content, enforced both
# server-side and in the review textarea's `maxlength` — see
# config/reviews.php.
REVIEWS_MAX_LENGTH=300

# Local development mail — no credentials. Mail is written to the log
# instead of being sent, until a real provider is configured in a later stage.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
